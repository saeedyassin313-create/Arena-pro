# GEMINI_API_KEY: Required for server-side Gemini AI tournament scheduling and direct knockout placement.
# AI Studio injects this at runtime from your Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Optional Email Delivery (Gmail SMTP via Nodemailer or Resend) for automated match schedule emails:
# Default official sender is saeedyassin313@gmail.com
# RESEND_API_KEY=""
# RESEND_FROM="Arena Pro <saeedyassin313@gmail.com>"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="saeedyassin313@gmail.com"
# SMTP_PASS="YOUR_GMAIL_APP_PASSWORD"
# SMTP_FROM="Arena Pro <saeedyassin313@gmail.com>"
